# Copy to .env and fill in real values. .env is gitignored.

# SQLite is the default so the project runs with zero setup for grading/dev.
# For a real deployment, point this at PostgreSQL instead, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/access_control
DATABASE_URL=sqlite:///./access_control.db

JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USE_TLS=false
MQTT_USERNAME=
MQTT_PASSWORD=

# Set to "true" to disable the MQTT background listener (useful for running
# the API/tests without a broker available).
DISABLE_MQTT=false
