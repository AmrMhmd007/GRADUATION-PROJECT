**/__pycache__/
*.pyc
**/.env
**/*.db
**/*.db-journal
**/media/
**/.pytest_cache/
backend.log

# --- Dashboard (Node) ---
**/node_modules/
**/dist/
*.log
npm-debug.log*

# --- Editor/misc ---
.vscode/*
!.vscode/extensions.json
.idea

