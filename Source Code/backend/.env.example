# Copy to .env and fill in real values. .env is gitignored.

# SQLite is the default so the project runs with zero setup for grading/dev.
# For a real deployment, point this at PostgreSQL instead, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/access_control
DATABASE_URL=sqlite:///./access_control.db

JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USE_TLS=false
MQTT_USERNAME=
MQTT_PASSWORD=

# Set to "true" to disable the MQTT background listener (useful for running
# the API/tests without a broker available).
DISABLE_MQTT=false

# Comma-separated CORS origins (default "*" = any origin, for local dev only).
# Set to the dashboard URL(s) for any shared or deployed instance.
ALLOWED_ORIGINS=*

# --- Security keys (REQUIRED for any shared or deployed instance) ---
# Generate with the commands in Documents/CONFIGURATION.md and keep them stable
# across restarts. Leave unset for throw-away local development only.
# JWT_SECRET=<long random string>
# CREDENTIAL_ENCRYPTION_KEY=<Fernet key>
# CREDENTIAL_INDEX_KEY=<long random string>

# Fernet key. Generate ONCE and keep it stable and backed up (see
# Documents/CONFIGURATION.md): changing it makes stored card UIDs, Face ID
# templates and device secrets unreadable. An invalid value stops start-up.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- Device identity / MQTT message authentication (Phase 1B) ---
# off | warn (default) | enforce. "warn" records findings and blocks nothing.
# Do not set "enforce" until every real node is registered and signing.
# MQTT_AUTH_MODE=warn
# MQTT_AUTH_MAX_SKEW_SECONDS=120
# MQTT_AUTH_EVENT_THROTTLE_SECONDS=300

# --- Database tests / migrations ---
# Run the test-suite against another database (it is DROPPED and recreated
# between tests - use a throw-away one):
# TEST_DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/access_control_test

# --- Face ID prototype (optional) ---
# Empty = the HTTP node endpoints are disabled. "none" = no embedding provider installed.
# FACE_NODE_API_KEY=
# FACE_EMBEDDING_PROVIDER=none

# Every other tunable (timeouts, thresholds, intervals) has a sane default;
# see Documents/CONFIGURATION.md for the full list.
